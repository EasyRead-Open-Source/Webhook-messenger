{
  "name": "app-store-feishu-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "check": "npm test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0"
  },
  "devDependencies": {
    "miniflare": "5.20261023.3-beta",
    "wrangler": "4.156.0"
  }
}
